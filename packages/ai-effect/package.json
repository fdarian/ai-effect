{
	"name": "ai-effect",
	"version": "7.1.0",
	"description": "Effect-native wrappers for the Vercel AI SDK",
	"type": "module",
	"license": "Apache-2.0",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"imports": {
		"#src/*": "./src/*"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"build": "tsdown",
		"check:type": "tsc --noEmit",
		"check:lint": "biome lint .",
		"test": "vitest run"
	},
	"devDependencies": {
		"@ai-sdk/otel": "1.0.169",
		"@effect/opentelemetry": "4.1.3",
		"@opentelemetry/api": "1.9.1",
		"@opentelemetry/context-async-hooks": "2.12.1",
		"@opentelemetry/resources": "2.12.1",
		"@opentelemetry/sdk-trace-base": "2.12.1",
		"@total-typescript/tsconfig": "1.0.4",
		"@types/node": "26.6.6",
		"ai": "7.0.169",
		"effect": "4.1.3",
		"tsdown": "0.23.7",
		"typescript": "7.0.2",
		"vitest": "5.1.0",
		"zod": "4.6.7"
	},
	"peerDependencies": {
		"ai": "^7",
		"effect": "^4"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/fdarian/ai-effect.git"
	},
	"homepage": "https://ai-effect.fdarian.com",
	"bugs": {
		"url": "https://github.com/fdarian/ai-effect/issues"
	},
	"keywords": [
		"effect",
		"ai",
		"ai-sdk",
		"vercel",
		"llm"
	]
}
